package views

import "github.com/MikelGV/Personal-Website/internal/components/layout"

templ Blog() {
	@layout.Base("Blog — MikelGV", "blog") {
		<section class="space-y-6">
			<h1 class="text-3xl font-bold tracking-tight">Blog</h1>
			<p class="text-lg leading-relaxed text-stone-600">
				Thoughts and notes on software engineering and technology.
			</p>
		</section>
	}
}
