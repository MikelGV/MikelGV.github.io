package views

import (
	"github.com/MikelGV/Personal-Website/internal/components/layout"
	"github.com/MikelGV/Personal-Website/internal/components/ui"
)

templ AboutMe() {
	@layout.Base("About Me — MikelGV", "about") {
		<section class="flex flex-col space-y-8">
            <div class="relative flex w-full flex-col items-center gap-8 justify-start md:flex-row" id="first">
                <div class="hidden lg:block absolute bottom-0 h-px bg-gray-200/80" style="left: calc(-50vw + 50%); width: calc(50vw + 10% + 4px);"></div>
                <div class="relative w-full md:w-3/5 shrink-0 text-left border-b border-gray-200/80 lg:border-b-0 pb-4">
                <h1 class="text-xl font-bold tracking-tight font-aldrich underline">ABOUT ME</h1>
                <p class="text-lg font-aldrich leading-relaxed">
                    I'm a backend-focused software developer from Spain, self-taught, 
                    with a passion for distributed systems, developer tooling, 
                    and building things that are fast, reliable, and actually useful.
                </p>
                </div>
            </div>
            <div class="relative flex w-full flex-col items-center gap-8 justify-end md:flex-row" id="second">
                <div class="hidden lg:block absolute bottom-0 h-px bg-gray-200/80" style="left: calc(40% - 4px); width: calc(50vw + 10% + 4px);"></div>
                <div class="w-full md:flex-1 pb-4 order-2 md:order-1">
                    @ui.AboutImage("Journey preview", "aspect-square")
                </div>
                <div class="relative w-full md:w-3/5 shrink-0 text-left border-b border-gray-200/80 lg:border-b-0 pb-4 order-1 md:order-2">
                <h2 class="font-aldrich font-semibold">How I got here</h2>
                <p class="font-aldrich">
                I started programming seriously in 2019, teaching myself through projects and experimentation. 
                During the COVID-19 pandemic, an opportunity to work abroad fell through, so I pivoted to freelance web development.
                </p>
                <p class="font-aldrich mt-10">
                Working directly with clients taught me how to build software for 
                real people rather than just for tutorials or personal projects. 
                I had to figure things out independently, work within constraints, 
                communicate clearly, and ship things that actually worked.
                </p>
                <p class="font-aldrich">
                    That experience eventually led me toward backend engineering and more complex systems. 
                    I later joined an early-stage CI/CD project as an independent contributor, 
                    where I worked on scalable APIs, container orchestration and monitoring features, 
                    and internal tooling using Go, PostgreSQL, Docker, and Kubernetes. 
                    Working in a small team meant dealing with ambiguity, making architectural decisions, 
                    and often solving problems without an obvious answer.
                </p>
                </div>
            </div>
            <div class="relative flex w-full flex-col items-center gap-8 justify-start md:flex-row" id="third">
                <div class="hidden lg:block absolute bottom-0 h-px bg-gray-200/80" style="left: calc(-50vw + 50%); width: calc(50vw + 10% + 4px);"></div>
                <div class="relative w-full md:w-3/5 shrink-0 text-left border-b border-gray-200/80 lg:border-b-0 pb-4">
                <h2 class="font-aldrich font-semibold">What I build</h2>
                <p class="font-aldrich">
                    I enjoy backend systems, distributed infrastructure, and 
                    developer tooling. Understanding how things work under 
                    the hood and building them from the ground up.
                </p>
                <div class="">
                    <p class="font-aldrich">
                        Some personal projects I’m proud of include:
                    </p>
                    <ul class="list-disc space-y-1 pl-5 ml-10">
                    <li class="font-aldrich">
                        Contyard — a real-time TUI for container monitoring
                    </li>
                    <li class="font-aldrich">
                        PrepPulse — a terminal tool for querying large tabular datasets
                    </li>
                    <li class="font-aldrich">
                        PierceMQ — a distributed task queue built on Redis Streams and PostgreSQL
                    </li>
                    </ul>
                </div>
                <p class="font-aldrich">
                    My main tools are Go, TypeScript/JavaScript, and Python, 
                    with hands-on experience across PostgreSQL, 
                    Docker, Kubernetes, AWS, Hetzner, and CI/CD pipelines.
                </p>
                </div>
                <div class="w-full md:flex-1 pb-4">
                    @ui.AboutImage("Build preview", "aspect-video")
                </div>
            </div>
            <div class="relative flex w-full flex-col items-center gap-8 justify-end md:flex-row" id="fourth">
                <div class="hidden lg:block absolute bottom-0 h-px bg-gray-200/80" style="left: calc(40% - 4px); width: calc(50vw + 10% + 4px);"></div>
                <div class="w-full md:flex-1 pb-4 order-2 md:order-1">
                    @ui.AboutImage("Next preview", "aspect-[4/3]")
                </div>
                <div class="relative w-full md:w-3/5 shrink-0 text-left border-b border-gray-200/80 lg:border-b-0 pb-4 order-1 md:order-2">
                <h2 class="font-aldrich font-semibold">
                    What's next
                </h2>
                <p class="font-aldrich">
                    I'm now looking for my next step, ideally on a remote, international 
                    team where I can work on meaningful products, tackle challenging backend 
                    and infrastructure problems, and continue growing as an engineer.
                </p>
                </div>
            </div>
            <div class="relative flex w-full flex-col items-center gap-8 justify-start md:flex-row" id="fifth">
                <div class="relative w-full md:w-3/5 shrink-0 text-left pb-4">
                <h2 class="font-aldrich font-semibold text-xl">Stay Connected</h2>
                <p class="font-aldrich mt-4 text-xl">Let the good work begin.</p>
                <div class="mt-6">
                    <a class="inline-flex items-center justify-center px-6 py-3 border border-2 font-aldrich text-pf-text/80 transition-colors hover:text-pf-accent" href="/contact">
                        Want to chat click here
                    </a>
                </div>
                <div class="mt-6 flex items-center gap-8">
                    <a class="text-pf-text/80 transition-colors hover:text-pf-accent" href="https://github.com/MikelGV" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><title>GitHub</title><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"></path></svg>
                    </a>
                    <a class="text-pf-text/80 transition-colors hover:text-pf-accent" href="https://x.com/mikisodlag" target="_blank" rel="noopener noreferrer" aria-label="X">
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><title>X</title><path d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"></path></svg>
                    </a>
                    <a class="text-pf-text/80 transition-colors hover:text-pf-accent" href="https://linkedin.com/in/mikelgv" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><title>LinkedIn</title><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
                    </a>
                </div>
                </div>
                <div class="w-full md:flex-1 pb-4">
                    @ui.AboutImage("Connect preview", "aspect-video")
                </div>
            </div>
		</section>
	}
}
