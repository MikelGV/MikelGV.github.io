package views

import "github.com/MikelGV/Personal-Website/internal/components/layout"

templ Contact() {
	@layout.Base("Contact — MikelGV", "contact") {
		<section class="space-y-6">
			<h1 class="text-3xl font-bold tracking-tight">Contact</h1>
			<p class="text-lg leading-relaxed text-stone-600">
				Get in touch — I'd love to hear from you.
			</p>
		</section>
	}
}
