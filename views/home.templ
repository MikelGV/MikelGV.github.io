package views

import "github.com/MikelGV/Personal-Website/internal/components/layout"

templ Home() {
	@layout.Base("MikelGV", "home") {
		<section class="space-y-6">
			<h1 class="text-4xl font-bold tracking-tight">MikelGV</h1>
			<p class="text-lg leading-relaxed text-stone-600">
				Software engineer building things on the internet.
			</p>
		</section>
	}
}
