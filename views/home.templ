package views

import (
	"github.com/MikelGV/Personal-Website/internal/components/layout"
	"github.com/MikelGV/Personal-Website/internal/components/ui"
	"github.com/MikelGV/Personal-Website/internal/data"
)

templ Home(projects []data.Project) {
	@layout.Base("MikelGV", "home") {
        <div class="space-y-6">
            <div class="space-y-6 lg:grid lg:grid-cols-3 lg:gap-x-8 lg:gap-y-6 lg:space-y-0">
                <div id="top" class="lg:col-span-3 space-y-6">
                    <h1 class="text-3xl font-aldrich tracking-tight text-pf-text lg:text-4xl">
                        Hi, I'm Mikel Galdos - Software
                        <br/>
                        Developer
                    </h1>
                    <p class="text-base leading-relaxed font-aldrich text-pf-text/80 lg:text-lg">
                        Summary
                    </p>
                    <p class="text-base font-aldrich leading-relaxed text-pf-text/80 lg:text-lg">
                        Started in 2019 as a freelance MERN developer, quietly helping local businesses build and maintain websites during 
                        <br/>
                        the COVID period.
                    </p>
                </div>
                <div id="middle-right" class="flex items-center justify-start lg:col-start-3 lg:justify-end mt-4 lg:mt-0">
                    <a href="/resume"
                        class="inline-flex items-center px-4 text-sm font-medium">
                        CV
                    </a>
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 rotate-300">
                        <line x1="5" y1="12" x2="19" y2="12"/>
                        <polyline points="12 5 19 12 12 19"/>
                    </svg>
                </div>
                <div id="bottom" class="lg:col-span-3">
                    <p class="text-base leading-relaxed font-aldrich text-pf-text/80 lg:text-lg">
                        Later joined an early-stage startup (Digital Forge Works), where I designed and developed custom web applications and scalable APIs
                        using Golang, Next.js, and PostgreSQL, delivering measurable gains in efficiency and performance. Self-taught, proactive, and
                        specialized in building high-performance systems and developer tools.
                    </p>
                </div>
            </div>
            <div id="reachout" class="border-t border-gray-200/80" style="width: 100vw; margin-left: calc(50% - 50vw);">
                <div class="mx-auto max-w-6xl px-2 pt-4">
                    <div class="flex flex-col lg:flex-row">
                        <div class="flex-1">
                            <p class="text-lg font-semibold text-pf-text/80 font-aldrich">Reach Out</p>
                            <div class="mt-2 space-y-2">
                                <span class="flex items-center gap-2">
                                    <a href="https://x.com/mikisodlag" target="_blank" rel="noopener noreferrer" class="text-pf-text/80 text-sm font-aldrich hover:text-pf-accent">x.com/mikisodlag</a>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-pf-text/50">
                                        <line x1="5" y1="12" x2="19" y2="12"/>
                                        <polyline points="12 5 19 12 12 19"/>
                                    </svg>
                                </span>
                                <span class="flex items-center gap-2">
                                    <a href="mailto:mikelgaldosv@gmail.com" class="text-pf-text/80 font-aldrich text-sm hover:text-pf-accent">mikelgaldosv@gmail.com</a>
                                    <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-pf-text/50">
                                        <line x1="5" y1="12" x2="19" y2="12"/>
                                        <polyline points="12 5 19 12 12 19"/>
                                    </svg>
                                </span>
                            </div>
                        </div>
                        <div class="flex-1 mt-6 lg:mt-0">
                            <p class="text-lg font-semibold text-pf-text/80">Experience</p>
                            <div class="mt-2 space-y-4">
                                <div class="grid grid-cols-3 gap-2">
                                    <p class="text-pf-text/80 text-sm font-aldrich">Full-Stack Developer</p>
                                    <p class="text-pf-text/80 text-sm font-aldrich">Freelance</p>
                                    <p class="text-pf-text/80 text-sm text-right font-aldrich">2020-2024</p>
                                </div>
                                <div class="grid grid-cols-3 gap-2">
                                    <p class="text-pf-text/80 text-sm font-aldrich">Backend Developer</p>
                                    <p class="text-pf-text/80 text-sm font-aldrich">Digital Forge Works</p>
                                    <p class="text-pf-text/80 text-sm text-right font-aldrich">2024-2025</p>
                                </div>
                            </div>
                            <div class="relative mt-4 pt-4 border-t border-gray-200/80 lg:border-t-0">
                                <div class="hidden lg:block absolute top-0 h-px bg-gray-200/80" style="left: -4px; width: calc(50vw + 4px);"></div>
                                <p class="relative z-10 text-lg font-semibold text-pf-text/80 font-aldrich">Technologies</p>
                                <div class="mt-2 grid grid-cols-2 gap-x-4 gap-y-1 lg:grid-cols-3">
                                    <p class="text-pf-text/60 text-md font-aldrich">Golang</p>
                                    <p class="text-pf-text/60 text-md font-aldrich">Kubernetes</p>
                                    <p class="text-pf-text/60 text-md font-aldrich">NodeJS</p>
                                    <p class="text-pf-text/60 text-md font-aldrich">ReactJS</p>
                                    <p class="text-pf-text/60 text-md font-aldrich">TypeScript</p>
                                    <p class="text-pf-text/60 text-md font-aldrich">Python</p>
                                    <p class="text-pf-text/60 text-md font-aldrich">PostgreSQL</p>
                                    <p class="text-pf-text/60 text-md font-aldrich">Docker</p>
                                    <p class="text-pf-text/60 text-md font-aldrich">AWS</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
			@ui.PopularProjects(projects)
			@ui.PopularBlogs()
			@ui.LandingContact()
        </div>
	}
}
