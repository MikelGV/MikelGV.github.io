package ui

templ LandingContact() {
    <div class="border-t border-gray-200/80" style="width: 100vw; margin-left: calc(50% - 50vw);">
        <div class="mx-auto max-w-6xl px-2 pt-4 pb-8">
            <div class="flex items-center" id="top button">
                <h2 class="text-aldrich">
                    Contact
                </h2>
            </div>
            <div class="flex items-center" id="top button">
                <a class=" border border-2 font-aldrich" href="/contact">
                    Want to chat click here
                </a>
            </div>
            <div class="flex items-center" id="bottom">
                <a class="" href="github.com/MikelGV" target="_blank">
                github image
                </a>
                <a class="" href="x.com/mikisodlag" target="_blank">
                x
                </a>
                <a class="" href="linkedin.com/something" target="_blank">
                linkedin image
                </a>
            </div>
        </div>
    </div>
}
