package ui

import (
	"strings"

	"github.com/MikelGV/Personal-Website/internal/data"
)

templ PopularProjects(projects []data.Project) {
	<div class="border-t border-gray-200/80" style="width: 100vw; margin-left: calc(50% - 50vw);">
		<div class="mx-auto max-w-6xl px-4 pt-4 pb-8">
			<div class="flex items-baseline gap-3">
				<p class="text-lg font-semibold font-aldrich text-pf-text/80">Selected Projects</p>
				<a href="/projects" class="font-aldrich text-sm text-pf-accent hover:text-pf-text">View all →</a>
			</div>
			for i, p := range projects {
				if i < 3 {
					<div class={ "mr-0 border-gray-200/80 md:ml-18 md:[margin-right:calc(-50vw_+_50%_-_8px)]", templ.KV("border-b", i < 2 && i < len(projects)-1) }>
						<div class="flex flex-col gap-3 py-4 md:flex-row md:items-start">
							<div class="w-full shrink-0 md:w-48">
								<p class="text-base font-semibold text-pf-text font-aldrich">{ p.Name }</p>
								if p.Year != "" {
									<p class="font-aldrich text-xs text-pf-text/40">{ p.Year }</p>
								}
							</div>
							<div class="flex flex-1 flex-col items-start gap-3 md:flex-row md:items-center md:justify-between">
								<div class="flex flex-col gap-2 md:flex-row md:items-center md:gap-8">
									<p class="text-sm text-pf-text/80 font-aldrich max-w-sm">
										{ p.Description }
									</p>
									if p.GitHub != "" {
										<a href={ p.GitHub } target="_blank" rel="noopener noreferrer" class="text-sm text-pf-text font-aldrich hover:text-pf-text break-all md:break-normal md:whitespace-nowrap">
											{ strings.TrimPrefix(p.GitHub, "https://") }
										</a>
									}
								</div>
								<a href="/projects" class="text-sm font-aldrich text-pf-text/80 hover:text-pf-accent border border-gray-200/80 rounded px-3 py-2 whitespace-nowrap self-start md:mr-20 md:self-auto md:py-1.5">
									Learn More
								</a>
							</div>
						</div>
					</div>
				}
			}
		</div>
	</div>
}
