package ui

templ PopularProjects() {
    <div class="border-t border-gray-200/80" style="width: 100vw; margin-left: calc(50% - 50vw);">
        <div class="mx-auto max-w-6xl px-2 pt-4 pb-8">
            <p class="text-lg font-semibold font-aldrich text-pf-text/80">Cool Projects</p>
            <div class="ml-18 border-b border-gray-200/80" style="margin-right: calc(-50vw + 50% - 4px);">
                <div class="flex items-start py-4">
                    <div class="w-48 shrink-0">
                        <p class="text-base font-semibold text-pf-text font-aldrich">PierceMQ</p>
                    </div>
                    <div class="flex items-center justify-between flex-1">
                        <div class="flex items-center gap-8">
                            <p class="text-sm text-pf-text/80 font-aldrich max-w-sm">
                                A lightweight message queue built in Go, designed for high-throughput
                                and low-latency message delivery.
                            </p>
                            <a href="https://github.com/MikelGV/piercemq" target="_blank" class="text-sm text-pf-accent font-aldrich hover:text-pf-text whitespace-nowrap">
                                github.com/MikelGV/piercemq
                            </a>
                        </div>
                        <a href="/project/piercemq" class="text-sm font-aldrich text-pf-text/80 hover:text-pf-accent border border-gray-200/80 rounded px-3 py-1.5 mr-20 whitespace-nowrap">
                            Learn More
                        </a>
