package layout

templ Base(title string, active string, children ...templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="preconnect" href="https://fonts.googleapis.com">
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
			<link href="https://fonts.googleapis.com/css2?family=Aldrich&display=swap" rel="stylesheet">
			<link rel="stylesheet" href="/static/css/output.css"/>
			<script src="/static/js/htmx.min.js"></script>
		</head>
		<body class="min-h-screen flex flex-col bg-pf-bg text-pf-text antialiased overflow-x-hidden">
            @TopBar(active)
			<main class="mx-auto w-full max-w-6xl flex-1 px-2 py-12">
				{ children... }
			</main>
            @Footer()
		</body>
	</html>
}
