package layout

templ Base(title string, active string, children ...templ.Component) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<link rel="stylesheet" href="/static/css/output.css"/>
			<script src="/static/js/htmx.min.js"></script>
		</head>
		<body class="min-h-screen flex flex-col bg-stone-50 text-stone-900 antialiased">
            @TopBar(active)
			<main class="mx-auto w-full max-w-4xl flex-1 px-4 py-12">
				{ children... }
			</main>
            @Footer()
		</body>
	</html>
}
