package layout

import "time"

templ Footer() {
	<footer class="border-t border-stone-200 py-8 text-sm text-pf-text/50">
		<div class="mx-auto grid max-w-6xl grid-cols-1 gap-6 px-4 text-center sm:grid-cols-3 sm:gap-4 sm:text-left">
			<div class="grid grid-cols-2 gap-x-6 gap-y-2 justify-items-center sm:justify-items-start">
				<a href="https://www.linkedin.com/in/mikel-galdos-ab8050187/" target="_blank" class="font-aldrich py-1" rel="noopener noreferrer">LinkedIn</a>
				<a href="https://github.com/MikelGV" target="_blank" class="font-aldrich py-1" rel="noopener noreferrer">GitHub</a>
				<a href="https://x.com/mikisodlag" target="_blank" class="font-aldrich py-1" rel="noopener noreferrer">X</a>
				<a href="https://instagram.com/MikelGV" target="_blank" class="font-aldrich py-1" rel="noopener noreferrer">Instagram</a>
			</div>
			<div class="order-last text-center font-aldrich sm:order-none">
				&copy; { time.Now().Year() } MikelGV. All rights reserved.
			</div>
			<div class="grid content-start justify-items-center gap-1 sm:justify-items-end">
				<a href="mailto:mikelgaldosv@gmail.com" class="font-aldrich break-all">mikelgaldosv@gmail.com</a>
				<span class="font-aldrich">Based In Spain</span>
			</div>
		</div>
	</footer>
}
